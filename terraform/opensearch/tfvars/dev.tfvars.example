# OpenSearch module dev values.
# Note: common-dev.tfvars is NOT passed to this module — all values go here.

venue     = "dev"
managedby = "<your-email>"

domain_name   = ""
ebs_volume_gb = 100

# Cluster sizing — dev uses minimal footprint, single-AZ, no dedicated masters
data_node_instance_type   = "t3.medium.search"
data_node_count           = 1
master_node_instance_type = "t3.medium.search"
master_node_count         = 3
dedicated_master_enabled  = false
zone_awareness_enabled    = false

# VPC — OpenSearch deployed inside the same VPC as Logstash EC2
vpc_enabled              = true
vpc_id                   = ""
vpc_subnet_ids           = []
ec2_security_group_name  = ""   # Name of the MCP EC2 security group

# Leave all three false for the initial bootstrap deploy.
# o11y_cloudfront_*: flip to true once each consumer has deployed and published its role ARN to SSM
#   (access-policy update only, no domain redeployment). See terraform/README.md#deployment-flow.
# dashboards_enabled: flip to true once pdc-cds-infra cognito/user-pool has been deployed with
#   opensearch_dashboards_callback_urls pointing at this domain's endpoint (triggers a domain
#   configuration update — not a replacement, but takes ~10 min to apply).
o11y_cloudfront_batch_enabled     = false
o11y_cloudfront_streaming_enabled = false
dashboards_enabled                = false

engine_version = "OpenSearch_2.19"
