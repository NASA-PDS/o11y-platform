# OpenSearch module dev values.
# Note: common-dev.tfvars is NOT passed to this module — all values go here.

venue     = "dev"
managedby = "<your-email>"

domain_name   = ""
ebs_volume_gb = 100

# Cluster sizing — dev uses minimal footprint, single-AZ, no dedicated masters
data_node_instance_type   = "t3.medium.search"
data_node_count           = 1
master_node_instance_type = "t3.medium.search"
master_node_count         = 3
dedicated_master_enabled  = false
zone_awareness_enabled    = false

# VPC — OpenSearch deployed inside the same VPC as Logstash EC2
vpc_enabled              = true
vpc_id                   = ""
vpc_subnet_ids           = []
ec2_security_group_name  = ""   # Name of the MCP EC2 security group

# Leave both false for the initial bootstrap deploy — flip to true and re-apply
# (access-policy update only, no domain redeployment) once each consumer has
# deployed and published its role ARN to SSM. See terraform/README.md#deployment-flow.
web_analytics_enabled    = false
realtime_monitor_enabled = false

engine_version = "OpenSearch_2.19"
