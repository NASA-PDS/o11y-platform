[
  {
    "Sid": "AllowEC2Role",
    "Effect": "Allow",
    "Principal": [
      "arn:aws:iam::{account_id}:role/pds-mcp-ec2-instance-role",
      "arn:aws:iam::{account_id}:role/service-role/pds-cloudfront-realtime-firehose-role"
    ],
    "Action": ["es:*"],
    "Resource": [
      "arn:aws:es:{region}:{account_id}:domain/{domain_name}",
      "arn:aws:es:{region}:{account_id}:domain/{domain_name}/*"
    ]
  }
]
