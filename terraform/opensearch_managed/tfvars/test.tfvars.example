# OpenSearch module test values.
# Note: common-dev.tfvars is NOT passed to this module — all values go here.

venue     = "test"
managedby = "<your-email>"

domain_name   = ""
ebs_volume_gb = 200

# Cluster sizing — test mirrors prod topology but smaller instance sizes
data_node_instance_type   = "r6g.large.search"
data_node_count           = 2
master_node_instance_type = "c6g.large.search"
master_node_count         = 3
dedicated_master_enabled  = true
zone_awareness_enabled    = true

# VPC — OpenSearch deployed inside the same VPC as Logstash EC2
vpc_enabled           = true
vpc_id                = ""
vpc_subnet_ids        = []   # Provide one subnet per AZ for zone awareness
ec2_security_group_name    = ""   # Name of the MCP EC2 security group
firehose_security_group_id = ""   # SG ID of the Kinesis Firehose delivery stream

engine_version = "OpenSearch_2.19"
